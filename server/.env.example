# Copy this file to .env and fill in real values before running the server.
PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
CORS_ORIGIN=http://localhost:5173

# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Email (used for password-reset links and new-comment notifications) ---
# Leave SMTP_HOST empty to disable emails (they just get logged to the
# console instead) — useful for local dev without a real mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DramaTV <no-reply@yourdomain.com>"

# Public site URL used to build password-reset links sent by email
SITE_URL=http://localhost:5173

# Where "forgot password" requests for the Admin account get emailed to
# (the admins table has no email column, so this is the single recovery
# address used for all admin accounts)
ADMIN_NOTIFY_EMAIL=
