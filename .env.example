# Copy this file to .env (same folder as package.json/vite.config.js)
# and rebuild (`npm run build`) for changes to take effect — these are
# build-time values baked into the static frontend bundle, not runtime
# settings read from the server.

# Custom base path for the entire Admin Panel — defaults to "admin" if
# unset (i.e. /admin, /admin/login, /admin/settings, ...). Change this to
# something hard to guess so casual visitors/bots scanning for the
# well-known /admin path won't find your login page at all.
#
# Example: set it to a random-looking slug, no leading/trailing slashes.
#   VITE_ADMIN_PATH=my-secret-panel-x7k9
#
# After changing this and rebuilding, also update public/robots.txt's
# Disallow lines to match (that file is static, not auto-generated).
VITE_ADMIN_PATH=admin
